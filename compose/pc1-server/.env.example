# ==========================================
# .env.example (Скопировать в .env перед запуском)
# ==========================================

# --- Сеть Yggdrasil ---
# IP-адрес машины в mesh-сети для доступа
PC1_YGG_IP=200:1234:5678::1

# --- Локальная сеть ---
# IP-адреса машин в локальной сети для взаимного общения
PC2_LAN_IP=192.168.0.11

# --- Мониторинг ---
# URL Loki для отправки логов (обычно адрес ПК2)
LOKI_URL=http://${PC2_LAN_IP}:3100/loki/api/v1/push

# --- Telegram Bot ---
TG_BOT_TOKEN=<YOUR_TG_BOT_TOKEN_HERE>

# --- База данных (PostgreSQL) ---
POSTGRES_USER=abm_admin
POSTGRES_PASSWORD=CHANGE_ME # Укажите сильный пароль
POSTGRES_DB=tg_comfy_db

# --- Хранилище (MinIO) ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME # Укажите сильный пароль

# --- Очередь (Redis) ---
REDIS_PASSWORD=CHANGE_ME # Укажите сильный пароль