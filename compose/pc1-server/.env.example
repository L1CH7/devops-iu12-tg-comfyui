# ==========================================
# .env.example (Скопировать в .env перед запуском)
# ==========================================

# --- Сеть Yggdrasil ---
# IP-адрес машины в mesh-сети для доступа
PC1_YGG_IP=200:1234:5678::1

# --- Системные пути ---
# Корневая директория для хранения персистентных данных томов на хосте (например, смонтированный HDD в /mnt/raid-hdd)
DATA_STORAGE_DIR=/srv/app-data
# Путь к папке моделей ComfyUI на хосте (например, отдельный SSD с моделями)
COMFYUI_MODELS_PATH=/srv/storage-models/models

# --- Локальная сеть ---
# IP-адреса машин в локальной сети для взаимного общения
PC2_LAN_IP=192.168.0.11

# --- Мониторинг ---
# URL Loki для отправки логов (обычно адрес ПК2)
LOKI_URL=http://<PC2_LAN_IP>:3100/loki/api/v1/push

# --- Telegram Bot ---
TG_BOT_TOKEN=<YOUR_TG_BOT_TOKEN_HERE>

# --- База данных (PostgreSQL) ---
POSTGRES_USER=abm_admin
POSTGRES_PASSWORD=CHANGE_ME # Укажите сильный пароль
POSTGRES_DB=tg_comfy_db

# --- Хранилище (MinIO) ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME # Укажите сильный пароль

# --- Очередь (Redis) ---
REDIS_PASSWORD=CHANGE_ME # Укажите сильный пароль

# --- n8n ---
# ВАЖНО: это ключ для шифрования credentials внутри n8n.
# Реальное значение хранится только в .env, в Git не коммитим.
N8N_ENCRYPT_KEY=CHANGE_ME

# --- AI Pipeline / n8n callback ---
# Webhook n8n, который server-api вызывает после создания задачи генерации.
# Для активированного production workflow:
N8N_GENERATION_WEBHOOK_URL=http://n8n:5678/webhook/generate-image

# Для ручного теста workflow из редактора n8n можно временно использовать:
# N8N_GENERATION_WEBHOOK_URL=http://n8n:5678/webhook-test/generate-image

# Callback URL, куда n8n сообщает server-api результат генерации.
PIPELINE_CALLBACK_URL=http://server-api:8000/api/generation-result

# Необязательный секрет между n8n и server-api.
# В .env.example оставляем пустым.
PIPELINE_CALLBACK_TOKEN=