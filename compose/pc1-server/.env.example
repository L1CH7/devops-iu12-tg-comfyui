# ==========================================
# .env.example (Скопировать в .env перед запуском)
# ==========================================

# --- Сеть Yggdrasil ---
# IP-адрес машины в mesh-сети для доступа
PC1_YGG_IP=200:1234:5678::1

# --- Локальная еть ---
# IP-адреса машин в локальной для взаимного общения
PC2_LAN_IP=192.168.0.11

# --- Telegram Bot ---
TG_BOT_TOKEN=<YOUR_TG_BOT_TOKEN_HERE>

# --- База данных (PostgreSQL) ---
POSTGRES_USER=abm_admin
POSTGRES_PASSWORD=supersecret_pg_password
POSTGRES_DB=tg_comfy_db

# --- Хранилище (MinIO) ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=supersecret_minio_password

# --- Очередь (Redis) ---
REDIS_PASSWORD=supersecret_redis_password